# QPay merchant API v2
# Sandbox: https://merchant-sandbox.qpay.mn   Production: https://merchant.qpay.mn
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
# QPay-ээс олгосон client_id / client_secret / invoice_code
QPAY_CLIENT_ID=TEST_MERCHANT
QPAY_CLIENT_SECRET=change-me
QPAY_INVOICE_CODE=TEST_INVOICE
# QPay-ээс хандах боломжтой энэ сервисийн public хаяг (callback энд ирнэ)
QPAY_CALLBACK_BASE_URL=https://pay.example.mn
QPAY_BRANCH_CODE=
# Төлбөр төлөгдмөгц и-баримт автоматаар үүсгэх эсэх
QPAY_EBARIMT_AUTO_CREATE=false
QPAY_EBARIMT_RECEIVER_TYPE=CITIZEN

# Өгөгдлийн сан (өгөхгүй бол ./data дотор H2 файл ашиглана)
# DB_URL=jdbc:postgresql://localhost:5432/payment
# DB_USERNAME=payment
# DB_PASSWORD=change-me
